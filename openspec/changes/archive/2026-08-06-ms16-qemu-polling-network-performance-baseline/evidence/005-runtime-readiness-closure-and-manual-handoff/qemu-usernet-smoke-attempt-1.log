    --scope qemu peer collector \
    --interval 0.1 \
    --duration 1.5 \
    | tee /tmp/ms16-host-cpu.ndjson
  COLLECT_EXIT=${PIPESTATUS[0]}
  printf 'collector_exit=%s\n' "$COLLECT_EXIT"
