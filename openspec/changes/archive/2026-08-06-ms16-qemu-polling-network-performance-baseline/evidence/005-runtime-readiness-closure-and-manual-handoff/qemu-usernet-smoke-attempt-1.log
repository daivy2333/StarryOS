  QEMU_PID="$(pgrep -n -f qemu-system-riscv64)"
  PEER_PID="$(pgrep -n -f '/tests/network_benchmark-host')"
  COLLECTOR_PID="$$"
  printf 'qemu_pid=%s peer_pid=%s collector_pid=%s\n' "$QEMU_PID" "$PEER_PID" "$COLLECTOR_PID"
  test -n "$QEMU_PID"
  test -n "$PEER_PID"
  kill -0 "$QEMU_PID"
  kill -0 "$PEER_PID"
  python3 scripts/network_benchmark_collect.py \
